  "id_rules": {
    "note": "ID 一旦发布不可改写；改名、改册次、换版次都靠 alias / equivalent_to / supersedes 表达，不靠改字符串。语义信息仅作人读，程序不得从 ID 反解含义。",
    "pattern_by_kind": {
      "volume": "^V[0-9]{3}$",
      "chapter": "^C[0-9]{3}-[0-9]{2}$",
      "section": "^S[0-9]{3}-[0-9]{1,2}\\.[0-9]{1,2}$",
      "knowledge_point": "^K[0-9]{3}-[0-9]{1,2}\\.[0-9]{1,2}-[0-9]{2}$",
      "question": "^([0-9]{3}-)?[0-9]{1,2}\\.[0-9]{1,2}_(bas|std|adv|cha|com)_[0-9]{2,3}$",
      "rubric_point": "^(RB|RP)-.+$",
      "skill": "^SK-.+$",
      "misconception": "^MC-.+$",
      "resource": "^RS-.+$",
      "asset": "^AS-.+$",
      "edge": "^ED-.+$",
      "alias": "^AL-.+$",
      "curriculum_standard": "^CS-.+$",
      "learner_evidence": "^EV-.+$"
    },
    "uid": {
      "required_from": "v3",
      "rule": "uid = kind 前缀 + 全局唯一主体键。存量记录（无 uid）视为 legacy，由 tools/schema_check.py 在有碰撞风险时提示；新记录必须带 uid。",
      "legacy_examples": [
        "12.1_bas_01（仅在本册内唯一）→ uid 801-12.1_bas_01"
      ]
    }
  },
