        "relation": "11 种：is_part_of、sequence（教材顺序，与先修必须分开）、prerequisite_of、supports、equivalent_to、contrast_with、applies_to（方法→知识）、uses_skill（知识→方法）、belongs_to（→思想/素养）、assessed_by、misconception_of。",
        "evidence": "[{type, ref, quote}]；type 取 enums.evidence_type。规则边用 type=teacher_note + ref=rule:<rule_id>",
        "review": "{status, reviewer, at}",
        "scope": "{curriculum_version, edition_id} 版本化，换教材不推翻历史",
        "direction": "有向=src→dst；equivalent_to 对称"
      },
      "legacy_fields": [
        "src",
        "dst",
        "kind",
        "strength",
        "evidence",
        "confidence",
        "review_status"
      ]
    },
    "alias": {
      "storage": "content/registry/aliases.jsonl",
      "desc": "别名与跨库 ID 映射表：术语/符号/旧 ID/外部 ID/版次名/拼音。检索与外部源接入都走它。",
      "legacy_required": [],
      "required": [
        "uid",
        "target_uid",
        "surface",
        "alias_type",
        "source"
      ],
      "optional": [
        "confidence",
        "review_status",
        "ext"
      ]
    },
    "learner_evidence": {
      "storage": "private/records/<child>/evidence.jsonl（永不入 public 切片）",
      "desc": "学习证据，只追加不修改（docx 表 5 学习证据 + 掌握度三件套）。",
      "legacy_required": [],
      "required": [
        "uid",
        "learner",
        "item_uid",
        "item_version",
        "ts",
        "response",
        "verdict"
      ],
      "optional": [
        "how",
        "hint_level",
        "seconds",
        "self_confidence",
        "session_id",
        "device",
        "app_version",
        "ext"
      ],
      "fields": {
        "learner": "假名化 ID；不写真实姓名/学校，不收集身份证、位置、通讯录",
        "verdict": "correct/wrong/manual/blank；manual 绝不允许在界面上显示为错",
        "hint_level": "取 enums.hint_level；L3/L4 做对记「带提示通过」，不计实测掌握"
      }
    },
    "thought": {
      "storage": "content/thoughts.jsonl",
      "desc": "数学思想与方法族。level=thought 是上位思想（不直接解题），level=family 是可操作的方法族；方法（skill）通过 thought_refs 上卷到方法族，再由 parent 上卷到思想。",
      "required": [
        "uid",
        "name",
        "level",
        "desc",
        "review_status"
      ],
      "optional": [
        "boundaries",
        "parent",
        "evidence",
        "examples",
        "ext"
      ],
      "fields": {
        "desc": "一句定义式描述，方法/思想页首段。",
        "boundaries": "不覆盖什么（与 knowledge_point.boundaries 同构）；参考源方法页的边界声明。",
        "parent": "上位思想 uid（family 必填，thought 为 null）。",
        "evidence": "[{type, ref, quote}]，type 取 enums.evidence_type。"
      }
    },
    "competency": {
      "storage": "content/registry/competencies.json",
      "desc": "义务教育数学课程标准的六个核心素养，固定 6 条，不增不减。",
      "required": [
        "uid",
        "code",
        "name"
      ],
      "optional": [
        "desc",
        "note",
        "ext"
      ]
    }
  },
  "capabilities": {
    "note": "运行层切片在 manifest 里声明自己支持什么，前端按此降级，不猜字段。",
    "list": [
      "knowledge_page",
      "practice",
      "hint_ladder",
      "rubric",
      "review_queue",
      "figure",
      "method_hint",
      "misconception_diagnosis",
      "export_outbox"
    ]
  },
  "interfaces": {
    "adapter": "tools/adapters/<source>.py: fetch() -> [{record, provenance{url, sha256, license, fetched_at}}]；外部源一律先落 content/sources/registry.jsonl 再入库",
    "judge": "judge(ref, student) -> {verdict, how, needsReview}；manual 优先于 wrong",
    "slice": "build/slices/<vol>.<scope>.json.gz + manifest.json{capabilities, schema_version, hash}",
    "export_graph": {
      "note": "边表由 tools/edges_build.py 从各源派生生成，不手改；前端切片按 relation+strength 过滤。"
    },
    "evidence_sync": "private/records/<child>/outbox.jsonl 只追加 + inbox.jsonl 回执；M4a 用文件导出/导入，接口不变"
  },
  "enum_aliases": {
    "edge_strength": {
      "soft": "support"
    }
  }
}
