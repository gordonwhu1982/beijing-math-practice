  "id": "registry.math-coach.entities",
  "review_status": "ai_draft",
  "updated": "2026-10-27",
  "purpose": "math-coach 权威内容层的实体与字段契约：校验器读它、构建器读它、前端按 capabilities 判断能力，而不是硬编码字段。",
  "compat": {
    "current": "3.1",
    "min_readable": "3",
    "policy": "只增不改义：字段一旦发布，含义与类型不得改变；改义必须新字段名 + 旧字段标 deprecated 至少一个大版本。旧记录缺新字段 = 覆盖率缺口，不算错误。",
    "unknown_field_policy": "未登记字段记 warning 并在报告中列出，不阻断构建；但不得出现在 public 切片（白名单生成）。",
    "ext_policy": "每个实体允许 ext 对象存放实验性字段，ext 内键名以 x- 开头，不参与校验、不进入 public 切片。"
  },
